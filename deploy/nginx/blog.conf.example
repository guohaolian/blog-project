# Nginx site example (adjust domain names and paths)

# ============================
# Option A (recommended): single domain
# - /        -> blog-web (SPA)
# - /admin/  -> blog-admin-web (SPA)
# - /api/    -> blog-api (Spring Boot)
# - /uploads -> static files on disk
# ============================

server {
    # Make this server the default for IP access (no domain)
    listen 80 default_server;
    server_name _;

    client_max_body_size 20m;

    # ---- paths (adjust to your server) ----
    # Put built files (dist/) here:
    #   blog-web/dist        -> /opt/blog/www/blog-web
    #   blog-admin-web/dist  -> /opt/blog/www/blog-admin-web
    root /opt/blog/www/blog-web;
    index index.html;

    # ---------- common proxy headers ----------
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ---------- API (keep /api prefix) ----------
    # Backend should expose endpoints like: /api/health, /api/admin/..., etc.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;

        # IMPORTANT: forward Authorization header for JWT (admin APIs + swagger "Authorize")
        proxy_set_header Authorization $http_authorization;
    }

    # ---------- Swagger / OpenAPI (optional) ----------
    # Access URLs (no domain):
    # - http://<server-ip>/swagger-ui.html
    # - http://<server-ip>/v3/api-docs
    # - http://<server-ip>/v3/api-docs.yaml
    # - http://<server-ip>/v3/api-docs/web
    # - http://<server-ip>/v3/api-docs/admin
    #
    # Security suggestion (no domain scenario):
    # - Restrict by IP (allow/deny) OR enable basic auth.
    location = /swagger-ui.html {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Authorization $http_authorization;

        # Option: allow internal network only
        # allow 127.0.0.1;
        # allow 10.0.0.0/8;
        # allow 172.16.0.0/12;
        # allow 192.168.0.0/16;
        # deny all;

        # Option: basic auth
        # auth_basic "Swagger";
        # auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location ^~ /swagger-ui/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Authorization $http_authorization;

        # Option: same protection as above
        # auth_basic "Swagger";
        # auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location ^~ /v3/api-docs {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Authorization $http_authorization;

        # Option: same protection as above
        # auth_basic "Swagger";
        # auth_basic_user_file /etc/nginx/.htpasswd;
    }

    # ---------- uploads mapping ----------
    # Important: use alias (not root) so /uploads/xxx maps to /opt/blog/uploads/xxx
    # Use ^~ to prevent other regex/static locations from taking precedence.
    location ^~ /uploads/ {
        alias /opt/blog/uploads/;
        autoindex off;
        access_log off;

        # cache static resources
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---------- admin SPA under /admin/ ----------
    # Place admin dist under: /opt/blog/www/blog-admin-web
    location ^~ /admin/ {
        alias /opt/blog/www/blog-admin-web/;
        try_files $uri $uri/ /admin/index.html;

        # no cache for html
        location ~* \.html$ {
            add_header Cache-Control "no-store";
        }

        # cache assets
        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            access_log off;
        }
    }

    # ---------- blog-web SPA ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # no cache for html
    location ~* \.html$ {
        add_header Cache-Control "no-store";
    }

    # cache assets
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # gzip (optional)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;
}

# ============================
# Option B: dual domain (legacy example)
# ============================
# NOTE:
# - If you're deploying by public IP (no domain), you usually do NOT need Option B.
# - Keeping multiple server blocks can make debugging harder (which server matched?).
# - Uncomment Option B only when you really have those domains configured.

